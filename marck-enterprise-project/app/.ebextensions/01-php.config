# Elastic Beanstalk reads this from the same bundle CodeDeploy uses.
# Keep deployment-only files out of the public web root on Beanstalk too.
container_commands:
  01_remove_deploy_files:
    command: "rm -rf scripts appspec.yml"

option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /
    display_errors: "Off"
