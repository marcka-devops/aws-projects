# Copy to infra/settings.env (git-ignored) and fill in. The Makefile exports these.
# Terraform reads TF_VAR_<name> as the value of variable <name>; stacks that don't
# declare a variable ignore it.

# Output "state_bucket" of infra/stacks/00-bootstrap
TF_STATE_BUCKET=marck-enterprise-tfstate-123456789012
TF_VAR_state_bucket=marck-enterprise-tfstate-123456789012

# A domain you own. Route 53 will host it (set the registrar's name servers to the zone's).
TF_VAR_domain_name=marckenterprise.com

# Your public IP for SSH, as a /32. Find it with: curl -s https://checkip.amazonaws.com
TF_VAR_admin_cidr=203.0.113.10/32

# GitHub owner (user or org) of this repository
TF_VAR_github_owner=marcka-devops

# Where alarms and budget alerts go (leave empty to skip)
TF_VAR_alert_email=

# Optional: your SSH public key for the web tier and QA instances
TF_VAR_ssh_public_key=
